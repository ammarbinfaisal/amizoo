# ---- Required in production -------------------------------------------------

# Encrypts the credential cookie (AES-256-GCM). Must be >= 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Base URL of the go-amizone HTTP API.
AMIZONE_API_URL=https://amizone.fly.dev

# ---- Optional ---------------------------------------------------------------

# Shared response cache. Without these the BFF falls back to a per-instance
# in-memory cache, which still helps within a warm Fluid Compute instance but is
# not shared across serverless invocations.
# Provision via Vercel Marketplace (Upstash Redis); KV_REST_API_* also works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bump to invalidate service-worker runtime caches.
NEXT_PUBLIC_CACHE_VERSION=v3
